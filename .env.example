# Equipo y competición
MI_EQUIPO_ID=0000
MI_EQUIPO_NOMBRE=Mi Equipo

# Notificaciones push con ntfy.sh (elige un nombre de canal privado)
ENABLE_NTFY=false
NTFY_TOPIC=mi-canal-privado

# Contacto incluido en el User-Agent (uso respetuoso)
USER_AGENT_EMAIL=contacto@example.com

# Correo de destino y credenciales SMTP
# Si usas Gmail: activa la verificación en 2 pasos y crea una
# "contraseña de aplicación" de 16 caracteres.
NOTIFICATION_EMAIL=destino@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=usuario@example.com
SMTP_PASS=tu_clave_de_aplicacion_de_16_caracteres

# Nivel de logs (INFO por defecto)
LOG_LEVEL=INFO
