# Configuración de Equipo y Competición
MI_EQUIPO_ID=5400
MI_EQUIPO_NOMBRE=Efro "B"

# Canal de notificaciones móviles push (ntfy.sh)
# Puedes elegir cualquier nombre único para tu canal privado
NTFY_TOPIC=efro-b-notificaciones-miguel

# Email de contacto para User-Agent respetuoso (robots.txt)
USER_AGENT_EMAIL=miguelmierc@gmail.com

# Notificación por correo electrónico a miguelmierc@gmail.com
# Para que te lleguen correos directos desde Gmail:
# 1. Ve a tu cuenta de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones.
# 2. Crea una con nombre "EfroBot" y copia la clave de 16 caracteres.
NOTIFICATION_EMAIL=miguelmierc@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=miguelmierc@gmail.com
SMTP_PASS=tu_clave_de_aplicacion_de_16_caracteres

